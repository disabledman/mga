{
  "name": "mga",
  "private": true,
  "version": "0.1.0",
  "description": "MGA — Multi-tenant web analytics (Collect → Queue → MSSQL API)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "predev": "npm run build -w @mga/shared -w @mga/sdk",
    "dev": "node scripts/dev.mjs",
    "db:init": "node scripts/init-db.mjs",
    "predb:reset": "npm run build -w @mga/shared",
    "db:reset": "node scripts/reset-db.mjs",
    "diag:queue": "node scripts/diag-queue.mjs",
    "diag:pipeline": "node scripts/diag-pipeline.mjs",
    "premaintenance:purge": "npm run build -w @mga/shared",
    "maintenance:purge": "node scripts/maintenance.mjs",
    "demo": "npx --yes serve examples -l 7500"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
